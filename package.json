{
  "name": "strk20-shadow-account-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Starknet Wallet API starter for STRK20 shadow accounts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starkience/strk20-shadow-account-starter.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "verify:contracts": "node scripts/verify-live-contracts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@starknet-io/get-starknet-discovery": "6.0.6",
    "@starknet-io/get-starknet-wallet-standard": "6.0.6",
    "@starknet-io/types-js": "0.10.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "starknet": "10.8.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
