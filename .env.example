# Required. Use one stable, unique Cairo short string (31 ASCII characters max).
# Every fork must change this value; it scopes the user's shadow identity.
VITE_SHADOW_DAPP_NAME=replace-with-your-app-name

# Optional RPC overrides. Never put private API keys in VITE_* variables.
VITE_MAINNET_RPC_URL=https://api.zan.top/public/starknet-mainnet/rpc/v0_10
VITE_SEPOLIA_RPC_URL=https://starknet-sepolia-rpc.publicnode.com
