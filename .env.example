# A funded, already-deployed Starknet Sepolia development account.
# Use a dedicated test account. Never use a production wallet key.
ACCOUNT_ADDRESS=
ACCOUNT_PRIVATE_KEY=

# Optional. When omitted, a deterministic viewing key is derived from the
# development account key. Do not reuse an account already registered with a
# different STRK20 viewing key.
VIEWING_KEY=

# AVNU private-paymaster access. Keep the API key server-side.
AVNU_PAYMASTER_API_KEY=

# Friendly demo choices.
SHADOW_APP_NAME=shadow-starter
SHADOW_NONCE=0
RECIPIENT_ADDRESS=
SPEND_AMOUNT_STRK=0.01
SHIELD_AMOUNT_STRK=5
MAX_PAYMASTER_FEE_STRK=5

# Pinned Sepolia defaults. Override only when intentionally testing a new stack.
STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com
POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
STRK_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
SHADOW_ACCOUNT_ANONYMIZER_ADDRESS=0x020b9f80cba4bda1f2edbbc8cab85d9a132559f7bdef9635f16af32d95b5afde
PROVER_URL=https://transaction-prover.alpha-sepolia.sw-dev.io
DISCOVERY_URL=https://discovery-service.alpha-sepolia.sw-dev.io
AVNU_PAYMASTER_URL=https://sepolia.paymaster.avnu.fi
